@model IEnumerable<_1_entity_framework_core.Models.Book>

<h2>Book List</h2>

<a asp-action="Create">Add New Book</a>

<br />
<br />

<table border="1" cellpadding="10">

    <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Author</th>
    </tr>

    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Title</td>
            <td>@book.Author</td>
        </tr>
    }

</table>