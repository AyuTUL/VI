<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Identity Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="container py-3">
    <nav class="mb-4">
        @if (User.IsInRole("Admin"))
        {
            <a class="ms-3" asp-controller="Home" asp-action="Admin">Admin</a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form class="d-inline ms-3" asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn btn-link p-0" type="submit">Log out</button>
            </form>
        }
        else
        {
            <a class="ms-3" asp-controller="Account" asp-action="Register">Register</a>
            <a class="ms-3" asp-controller="Account" asp-action="Login">Log in</a>
        }
    </nav>
    <main>
        @RenderBody()
    </main>
</body>
</html>
