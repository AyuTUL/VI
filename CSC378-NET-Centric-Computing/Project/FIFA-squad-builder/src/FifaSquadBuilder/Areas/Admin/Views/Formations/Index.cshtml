@model List<FifaSquadBuilder.ViewModels.Admin.FormationListItem>
@{
    ViewData["Title"] = "Manage Formations";
}

<h1>Manage Formations</h1>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-info">@status</div>
}

<p><a class="btn btn-primary" asp-action="Create">+ Add Formation</a></p>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Slots defined</th><th></th></tr></thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.Name</td>
                <td>@f.SlotCount / 11</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@f.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@f.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
