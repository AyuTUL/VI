        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor User\nactor Admin\n\nrectangle \&quot;Squad Management System\&quot; {\n  &#39; User Use Cases\n  usecase \&quot;Register Account\&quot; as UC_Register\n  usecase \&quot;Login / Logout\&quot; as UC_Auth\n  usecase \&quot;Create Squad\&quot; as UC_CreateSquad\n  usecase \&quot;Search &amp; Filter Players\&quot; as UC_SearchPlayers\n  usecase \&quot;Assign Player to Slot/Bench\&quot; as UC_AssignPlayer\n  usecase \&quot;Change Formation\&quot; as UC_ChangeFormation\n  usecase \&quot;View Squad Statistics &amp; Weak Positions\&quot; as UC_ViewStats\n  usecase \&quot;Delete Squad\&quot; as UC_DeleteSquad\n\n  &#39; Admin Use Cases\n  usecase \&quot;Manage Players (CRUD)\&quot; as UC_ManagePlayers\n  usecase \&quot;Manage Formations &amp; Pitch Slots\&quot; as UC_ManageFormations\n  usecase \&quot;Import Player Dataset\&quot; as UC_ImportDataset\n  usecase \&quot;Manage User Roles\&quot; as UC_ManageRoles\n}\n\n&#39; User Associations\nUser --&gt; UC_Register\nUser --&gt; UC_Auth\nUser --&gt; UC_CreateSquad\nUser --&gt; UC_SearchPlayers\nUser --&gt; UC_AssignPlayer\nUser --&gt; UC_ChangeFormation\nUser --&gt; UC_ViewStats\nUser --&gt; UC_DeleteSquad\n\n&#39; Admin Associations (Admin inherits or shares auth/registration if needed, or handles system management)\nAdmin --&gt; UC_Auth\nAdmin --&gt; UC_ManagePlayers\nAdmin --&gt; UC_ManageFormations\nAdmin --&gt; UC_ImportDataset\nAdmin --&gt; UC_ManageRoles\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PwWJeeuwzYg_rDsubcjC-53">
